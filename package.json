{
    "name": "smart-parking",
    "version": "1.0.0",
    "description": "Smart Parking Lot Management System",
    "main": "dist/index.js",
    "engines": {
        "node": ">=18.14.0"
    },
    "scripts": {
        "build": "tsc",
        "start": "tsc && node dist/index.js",
        "dev": "ts-node src/index.ts",
        "test": "jest",
        "test:watch": "jest --watch",
        "test:coverage": "jest --coverage",
        "typecheck": "tsc --noEmit && tsc --noEmit -p tsconfig.test.json"
    },
    "dependencies": {
        "async-mutex": "^0.4.0",
        "uuid": "^9.0.0"
    },
    "devDependencies": {
        "@types/jest": "30.0.0",
        "@types/node": "^20.0.0",
        "@types/uuid": "^9.0.0",
        "jest": "30.5.1",
        "ts-jest": "29.4.12",
        "ts-node": "^10.9.0",
        "typescript": "^5.3.0"
    }
}
